{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coderabbit.control/schemas/finding-record.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "id", "source", "classification", "invariant", "location", "status", "remediation", "provenance"],
  "properties": {
    "apiVersion": {"const": "coderabbit.control/v1"},
    "kind": {"const": "FindingRecord"},
    "id": {"type": "string", "minLength": 1},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "repository", "revision"],
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "repository": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
        "pull_request": {"type": ["integer", "null"], "minimum": 1},
        "revision": {"type": "string", "minLength": 1}
      }
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category"],
      "properties": {
        "category": {"type": "string", "minLength": 1},
        "language": {"type": ["string", "null"]},
        "trust_boundary": {"type": ["string", "null"]}
      }
    },
    "invariant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "confidence"],
      "properties": {
        "id": {"type": ["string", "null"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {"path": {"type": "string", "minLength": 1}}
    },
    "status": {"enum": ["confirmed", "dismissed", "deferred"]},
    "remediation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {"type": ["string", "null"]},
        "summary": {"type": "string"},
        "body": {"type": "string"}
      }
    },
    "provenance": {"type": "object"}
  }
}
