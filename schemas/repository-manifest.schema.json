{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coderabbit.control/schemas/repository-manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "repository", "profiles", "policy", "generation", "discovery"],
  "properties": {
    "apiVersion": {"const": "coderabbit.control/v1"},
    "kind": {"const": "RepositoryManifest"},
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "full_name"],
      "properties": {
        "provider": {"const": "github"},
        "full_name": {"type": "string", "pattern": "^[^/]+/[^/]+$"}
      }
    },
    "profiles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["explicit"],
      "properties": {
        "explicit": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["local"],
      "properties": {
        "local": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coderabbit", "pull_request_template", "markdown_policy", "ast_grep"],
      "properties": {
        "coderabbit": {"type": "boolean"},
        "pull_request_template": {"type": "boolean"},
        "markdown_policy": {"type": "boolean"},
        "ast_grep": {"type": "boolean"}
      }
    },
    "discovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allow_auto_detect", "minimum_confidence"],
      "properties": {
        "allow_auto_detect": {"type": "boolean"},
        "minimum_confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    }
  }
}
